# Neo4j 连接配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# LLM API 配置 (维纳斯平台 - 用于 Cypher 生成)
LLM_API_BASE=http://v2.open.venus.oa.com/llmproxy
LLM_API_KEY=your_venus_access_key@1
LLM_MODEL_NAME=deepseek-v3.2

# QA LLM 配置 (维纳斯平台 - 用于知识库问答 / AI 总结)
QA_LLM_API_BASE=http://v2.open.venus.oa.com/llmproxy
QA_LLM_API_KEY=your_venus_access_key@1
QA_LLM_MODEL=glm-5

# Embedding 模型配置 (本地 HuggingFace 模型)
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 服务配置
APP_HOST=0.0.0.0
APP_PORT=8000
